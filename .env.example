# ---- App ----
# Public origin of the deployed app (used for cookie domain/secure flags and links).
APP_URL=http://localhost:3000

# ---- Auth ----
# Secret used to sign/encrypt the session cookie (Auth.js). Generate a long random value.
AUTH_SECRET=replace-me-with-a-long-random-string
# Email whose account will be promoted to admin by the seed script (see scripts/seed-admin.ts).
ADMIN_SEED_EMAIL=admin@example.com
# Password for the seeded admin account (only read by scripts/seed-admin.ts, never committed).
ADMIN_SEED_PASSWORD=change-me-please

# ---- Database (PostgreSQL) ----
# Prisma connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/student_marketplace?schema=public
# Direct (non-pooled) URL for migrations, if your provider requires it (Neon). Can equal DATABASE_URL.
DIRECT_URL=postgresql://user:password@localhost:5432/student_marketplace?schema=public

# ---- Image storage (S3-compatible) ----
# Any S3-compatible endpoint (AWS S3, Cloudflare R2, Vercel Blob, MinIO for local dev).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=student-marketplace-images
STORAGE_REGION=auto
# Public base URL prefix for stored objects (CDN/bucket URL).
STORAGE_PUBLIC_URL=

# ---- Optional observability ----
# Sentry DSN (optional; leave empty to disable).
SENTRY_DSN=
